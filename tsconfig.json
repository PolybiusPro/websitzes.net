{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "paths": {
            "Experience/*": ["./src/js/Experience/*"],
            "@vituum/vite-plugin-twig": ["./node_modules/@vituum/vite-plugin-twig/types/index.d.ts"]
        }
    },
    "include": ["src/js", "src/vite-env.d.ts", "vite.config.ts"]
}
